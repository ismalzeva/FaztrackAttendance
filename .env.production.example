# Salin menjadi .env di server. Jangan commit nilai sebenarnya.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
FAZTRACK_JWT_SECRET=CHANGE_ME_WITH_RANDOM_SECRET_MINIMUM_32_CHARACTERS
APP_ORIGIN=https://attendance.example.com
PUBLIC_API_URL=https://api-attendance.example.com/api/v1
APP_DOMAIN=attendance.example.com
API_DOMAIN=api-attendance.example.com

# Hanya untuk bootstrap pilot, lalu hapus dari environment setelah dipakai.
FAZTRACK_DEMO_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
FAZTRACK_DEMO_WORKER_PIN=CHANGE_ME_6_DIGIT_PIN
