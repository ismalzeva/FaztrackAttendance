#!/usr/bin/env python3
"""
Minimal tenant bootstrap seed — generated by `fzctl onboard` for tenant "{{NAME}}".

Creates the tenant record, one admin user, and an ADMIN membership so the new
instance is immediately reachable at /login. Idempotent — safe to re-run.

Mirrors `seed_lumin_standalone.py` (the proven production pattern): read the
instance `.env.{{SLUG}}`, build the engine directly (NOT app.database.engine,
to avoid pydantic lru_cache / import-order surprises), then bootstrap schema
and the admin row.

Business master data (workers / projects / schedules / rule snapshots) is NOT
created here — that belongs in a dedicated `seed_{{SLUG}}_standalone.py` written
from the client's source sheet (see docs/CLIENT_ONBOARDING.md).

Credentials (admin password, worker PIN) are read from the instance env file
(`.env.{{SLUG}}`) — never stored in this file.

Usage:
  cd /home/ubuntu/FaztrackAttendance/backend
  .venv/bin/python scripts/seed_{{SLUG}}_standalone.py
"""

import os
import sys

from sqlalchemy import create_engine, select
from sqlalchemy.orm import Session, sessionmaker

BACKEND_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, BACKEND_DIR)

# --- load instance .env.{{SLUG}} (KEY=VALUE, no override of real env) ---
ENV_PATH = os.path.join(BACKEND_DIR, ".env.{{SLUG}}")
_env: dict = {}
if os.path.exists(ENV_PATH):
    with open(ENV_PATH) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            _env.setdefault(k.strip(), v.strip())

DB_URL = os.environ.get(
    "FAZTRACK_DATABASE_URL", _env.get("FAZTRACK_DATABASE_URL", "")
)
PASSWORD = os.environ.get(
    "FAZTRACK_DEMO_SEED_PASSWORD", _env.get("FAZTRACK_DEMO_SEED_PASSWORD", "")
)

if not DB_URL:
    raise RuntimeError("FAZTRACK_DATABASE_URL missing in " + ENV_PATH)
if not PASSWORD:
    raise RuntimeError("FAZTRACK_DEMO_SEED_PASSWORD missing in " + ENV_PATH)

engine = create_engine(DB_URL, pool_pre_ping=True)
SessionLocal = sessionmaker(bind=engine, autoflush=False, expire_on_commit=False)

# app imports AFTER sys.path fix and DB_URL resolution
from app.models import Base  # noqa: E402
from app.models import (  # noqa: E402
    Membership, MembershipStatus, RoleCode, Tenant, TenantStatus, User,
)
from app.security import hash_password  # noqa: E402

TENANT_ID = "{{TENANT_ID}}"
TENANT_CODE = "{{TENANT_CODE}}"
TENANT_NAME = "{{NAME}}"
TENANT_TIMEZONE = "{{TIMEZONE}}"
ADMIN_LOGIN = "{{ADMIN_LOGIN}}"
ADMIN_NAME = "{{ADMIN_NAME}}"


def main():
    # schema bootstrap (no-op if alembic already created tables)
    Base.metadata.create_all(engine)

    with SessionLocal.begin() as db:
        tenant = db.scalar(select(Tenant).where(Tenant.id == TENANT_ID))
        if tenant is None:
            tenant = Tenant(
                id=TENANT_ID, code=TENANT_CODE, name=TENANT_NAME,
                timezone=TENANT_TIMEZONE, status=TenantStatus.ACTIVE,
            )
            db.add(tenant)
            db.flush()

        user = db.scalar(select(User).where(User.login_id == ADMIN_LOGIN))
        if user is None:
            user = User(
                login_id=ADMIN_LOGIN, display_name=ADMIN_NAME,
                password_hash=hash_password(PASSWORD),
            )
            db.add(user)
            db.flush()

        if db.scalar(select(Membership).where(
            Membership.tenant_id == TENANT_ID,
            Membership.user_id == user.id,
            Membership.role == RoleCode.ADMIN,
        )) is None:
            db.add(Membership(
                id=f"mem-{TENANT_ID}-admin",
                tenant_id=TENANT_ID, user_id=user.id,
                role=RoleCode.ADMIN, status=MembershipStatus.ACTIVE,
            ))

    print(f"[seed] tenant={TENANT_CODE} admin={ADMIN_LOGIN} ok")


if __name__ == "__main__":
    main()
